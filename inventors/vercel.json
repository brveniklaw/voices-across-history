{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/inventors/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/inventors/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/inventors",
      "destination": "/inventors/index.html"
    },
    {
      "source": "/inventors/:path*",
      "destination": "/inventors/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
